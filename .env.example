# Environment Configuration for Car Gate Backend API

# Database - PostgreSQL
# Option A (local):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_gate?schema=public"
# Option B (hosted/Neon):
DATABASE_URL="postgresql://username:password@hostname/database?sslmode=require"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# App Configuration
PORT=3001
NODE_ENV=development

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081,http://localhost:19006"

# File Upload (Cloudinary - optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
